# Copy to .env and adjust. All values have working defaults for local dev.

# OpenAI-compatible endpoint of the local LLM server (llama.cpp, Ollama, LM Studio...).
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local

# Informative label logged with every decision. llama.cpp serves whatever model
# it was launched with regardless of this value; Ollama DOES route on it.
LLM_MODEL=qwen3-0.6b

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=160
# Hard cap on inference time so a stuck model can't stall the game loop.
LLM_TIMEOUT_S=30

# Brain used when the request doesn't specify one: "heuristic" or "model".
DEFAULT_BRAIN=heuristic

# Where decision JSONL logs are written.
LOG_DIR=logs
